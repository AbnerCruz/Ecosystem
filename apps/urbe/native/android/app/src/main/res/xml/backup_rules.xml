<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 e anterior (fullBackupContent). Coerente com allowBackup="false": nada do app entra em backup.
     As notas ficam em Documentos/Urbe (armazenamento compartilhado), que o Auto Backup nunca cobre. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
