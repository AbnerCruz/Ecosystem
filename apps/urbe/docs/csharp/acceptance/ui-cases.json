        "files": {
          "Base.md": "# Base\n"
        }
      },
      "expected": {
        "values": [
          {
            "idPresent": true
          },
          null,
          [
            {
              "path": "Pasta/Nota.md",
              "content": "# Nota\n\nlinha nova **forte**\n",
              "saved": "# Nota\n\nlinha nova **forte**\n",
              "idStable": true,
              "inWorld": true
            }
          ],
          null,
          [
            {
              "path": "Pasta/Nota.md",
              "content": "# Nota\n\nlinha nova **forte**\n",
              "saved": "# Nota\n\nlinha nova **forte**\n",
              "idStable": true,
