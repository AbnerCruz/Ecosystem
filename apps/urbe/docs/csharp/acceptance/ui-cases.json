    {
      "id": "ui-visual-save-reload",
      "operation": "ui.scenario",
      "requirements": [
        "REQ-027",
        "REQ-039",
        "REQ-042"
      ],
      "source": "docs/csharp/acceptance/ui-cases.json#/cases/2",
      "input": {
        "steps": [
          {
            "method": "create",
            "args": [
              "Pasta/Nota.md",
              "# Nota\n"
            ]
          },
          {
            "method": "visualAppend",
            "args": [
              "linha nova <strong>forte</strong>",
              "linha nova"
            ]
          },
          {
            "method": "observe",
            "args": [
              "Pasta/Nota.md"
            ]
          },
          {
            "method": "reload",
            "args": []
          },
          {
            "method": "observe",
            "args": [
              "Pasta/Nota.md"
            ]
          }
        ],
        "files": {
          "Base.md": "# Base\n"
        }
      },
      "expected": {
        "values": [
          {
            "idPresent": true
          },
          null,
          [
            {
              "path": "Pasta/Nota.md",
              "content": "# Nota\n\nlinha nova **forte**\n",
              "saved": "# Nota\n\nlinha nova **forte**\n",
              "idStable": true,
              "inWorld": true
            }
          ],
          null,
          [
            {
              "path": "Pasta/Nota.md",
              "content": "# Nota\n\nlinha nova **forte**\n",
              "saved": "# Nota\n\nlinha nova **forte**\n",
              "idStable": true,
              "inWorld": true
            }
          ]
        ]
      }
    },
