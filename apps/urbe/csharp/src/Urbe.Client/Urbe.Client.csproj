<Project Sdk="Microsoft.NET.Sdk">
  <!-- DEC-0043 / ADR-0032: interface nativa do Urbe (sem WebView), compartilhada por Desktop e Android. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Urbe.Client</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Conteúdo da prévia UC-33: a pasta Tutorial da 1.8.4, somente leitura. -->
    <EmbeddedResource Include="../../../tutorial/**/*" LogicalName="tutorial/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../PATCHNOTES.md" LogicalName="urbe/patchnotes.md" />
    <EmbeddedResource Include="../../PATCHNOTES-HISTORY.md" LogicalName="urbe/patchnotes-history.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Urbe.Core/Urbe.Core.csproj" />
  </ItemGroup>
</Project>
