@page "/cidade"
@implements IDisposable
@inject WorkspaceSession Workspace
@inject NavigationManager Navigation

@{
    var city = BuildCity();
}

<section class="surface world-surface" data-surface="world">
    <div class="world-header">
        <div>
            <p class="surface-eyebrow">UC-19 · Cidade interativa</p>
            <h1>Cidade</h1>
            <p class="surface-copy">Cada nota é uma casa, cada pasta é um bairro e os links entre notas formam estradas.</p>
        </div>
        <div class="world-counters" aria-label="Resumo da cidade">
            <span>@city.Buildings.Count casas</span>
            <span>@city.Districts.Count bairros</span>
            <span>@city.Roads.Count ligações</span>
        </div>
    </div>

    <div class="world-toolbar" role="group" aria-label="Controles da cidade">
        <button type="button" aria-label="Diminuir zoom"
                disabled="@(_zoom <= 0.75)" @onclick="ZoomOut">−</button>
        <span role="status" class="world-zoom-level">Zoom @((int)(_zoom * 100))%</span>
        <button type="button" aria-label="Aumentar zoom"
                disabled="@(_zoom >= 2.0)" @onclick="ZoomIn">+</button>
        <a href="explorer" class="world-explorer-link">Explorar arquivos</a>
    </div>

    <div class="world-viewport" aria-label="Mapa da cidade: deslize para explorar">
        <svg class="world-map"
             width="@((int)(city.Width * _zoom))"
             height="@((int)(city.Height * _zoom))"
             viewBox="@($"0 0 {city.Width} {city.Height}")"
             role="group" aria-label="Bairros e casas do vault">
            <defs>
                <pattern id="city-ground" width="32" height="32" patternUnits="userSpaceOnUse">
                    <rect width="32" height="32" fill="#162d23" />
                    <path d="M0 0H32M0 0V32" fill="none" stroke="#254734" stroke-width="0.65" />
                    <path d="M8 14h3M24 25h3M19 7h2" stroke="#2c5538" stroke-width="2" />
                </pattern>
            </defs>
            <rect x="0" y="0" width="@city.Width" height="@city.Height" fill="url(#city-ground)" />

            @foreach (var district in city.Districts)
            {
                <g class="city-district @(_selectedFolder == district.Path ? "is-selected" : "")"
                   role="button" tabindex="0"
                   aria-label="@($"Selecionar bairro {district.Name}")"
                   @onclick="() => SelectDistrict(district.Path)"
                   @onkeydown="args => OnDistrictKey(args, district.Path)">
                    <rect x="@district.X" y="@district.Y"
                          width="@district.Width" height="@district.Height"
                          rx="17" />
                    <text x="@(district.X + 22)" y="@(district.Y + 39)"
                          class="city-district-title">@district.Name</text>
                    <text x="@(district.X + 22)" y="@(district.Y + 65)"
                          class="city-district-count">@district.NoteCount casas</text>
                    <path d="@($"M {district.X + 18} {district.Y + 84} H {district.X + district.Width - 18}")"
                          class="city-district-divider" />
                </g>
            }

            @foreach (var road in city.Roads)
            {
                <line class="city-road-shadow" x1="@road.X1" y1="@road.Y1"
                      x2="@road.X2" y2="@road.Y2" />
                <line class="city-road" x1="@road.X1" y1="@road.Y1"
                      x2="@road.X2" y2="@road.Y2" />
            }

            @foreach (var building in city.Buildings)
            {
                <g class="city-building" role="button" tabindex="0"
                   aria-label="@($"Abrir nota {building.Title}")"
                   data-note-path="@building.Path"
                   transform="@($"translate({building.X} {building.Y})")"
                   @onclick="() => OpenNote(building)"
                   @onkeydown="args => OnBuildingKey(args, building)">
                    <rect class="city-building-shadow" x="4" y="7" width="62" height="52" rx="7" />
                    <rect class="city-building-walls" x="0" y="2" width="62" height="49" rx="5" />
                    <path class="city-building-roof" d="M-4 16 L31 -6 L66 16 Z" />
                    <rect class="city-building-window" x="11" y="21" width="12" height="13" rx="2" />
                    <rect class="city-building-window" x="38" y="21" width="12" height="13" rx="2" />
                    <rect class="city-building-door" x="26" y="33" width="11" height="18" rx="2" />
                    <text class="city-building-title" x="31" y="72"
                          text-anchor="middle">@ShortTitle(building.Title)</text>
                </g>
            }
        </svg>
    </div>

    @if (city.HiddenNoteCount > 0)
    {
        <p class="world-notice" role="status">
            Mostrando as primeiras @CityLayoutBuilder.MaxNotes notas; @city.HiddenNoteCount ficam disponíveis no Explorer.
        </p>
    }

    <div class="world-builder" aria-label="Construir na cidade">
        <div>
            <h2>Construir uma casa</h2>
            <p>Crie uma nota Markdown diretamente no bairro escolhido.</p>
        </div>
        <label class="field">
            <span>Título da nota</span>
            <input value="@_newTitle" @oninput="args => _newTitle = args.Value?.ToString() ?? string.Empty"
                   placeholder="Uma nova ideia" disabled="@Workspace.IsReadOnly" />
        </label>
        <label class="field">
            <span>Bairro</span>
            <select value="@_selectedFolder" @onchange="ChangeDistrict"
                    disabled="@Workspace.IsReadOnly">
                <option value="">Raiz</option>
                @foreach (var folder in Workspace.Folders.Where(folder => !ArtifactModel.IsSystem(folder)))
                {
                    <option value="@folder">@folder</option>
                }
            </select>
        </label>
        <button type="button" class="surface-action" @onclick="CreateHouse"
                disabled="@Workspace.IsReadOnly">Criar casa</button>
        @if (!string.IsNullOrEmpty(_status))
        {
            <p class="world-notice" role="status">@_status</p>
        }
    </div>

    @if (city.Buildings.Count == 0)
    {
        <p class="world-empty">A cidade está pronta. Crie a primeira nota para construir sua primeira casa.</p>
    }
    <p class="world-note">Distribuição visual provisória em memória. O posicionamento salvo do mapa será conectado pela integração dos hosts.</p>
</section>

@code {
    private WorldProjection? _projection;
    private double _zoom = 1;
    private string _selectedFolder = string.Empty;
    private string _newTitle = string.Empty;
    private string? _status;

    protected override void OnInitialized()
    {
        _projection = new WorldProjection(Workspace.Documents);
    }

    private CityLayout BuildCity() =>
        CityLayoutBuilder.Build(_projection!.Snapshot(), Workspace.Knowledge, Workspace.Folders);

    private void ZoomIn() => _zoom = Math.Min(2, Math.Round(_zoom + 0.25, 2));
    private void ZoomOut() => _zoom = Math.Max(0.75, Math.Round(_zoom - 0.25, 2));

    private void SelectDistrict(string path)
    {
        _selectedFolder = path;
        _status = null;
    }

    private void ChangeDistrict(ChangeEventArgs args)
    {
        _selectedFolder = args.Value?.ToString() ?? string.Empty;
        _status = null;
    }

    private void OnDistrictKey(KeyboardEventArgs args, string path)
    {
        if (args.Key is "Enter" or " ")
            SelectDistrict(path);
    }

    private void OnBuildingKey(KeyboardEventArgs args, CityBuilding building)
    {
        if (args.Key is "Enter" or " ")
            OpenNote(building);
    }

    private void OpenNote(CityBuilding building)
    {
        if (!Workspace.Open(
                building.DocumentId,
                new EditorOpenOrigin(EditorOpenOriginKind.City, "cidade")))
        {
            _status = "Não foi possível abrir esta nota.";
            return;
        }

        Navigation.NavigateTo("editor?path=" + Uri.EscapeDataString(building.Path));
    }

    private void CreateHouse()
    {
        if (string.IsNullOrWhiteSpace(_newTitle))
        {
            _status = "Dê um nome à nova casa.";
            return;
        }

        var created = Workspace.CreateNote(_newTitle, _selectedFolder);
        if (created is null)
        {
            _status = "Não foi possível criar a nota neste bairro.";
            return;
        }

        _status = "Casa criada: " + created.Path;
        _newTitle = string.Empty;
    }

    private static string ShortTitle(string title) =>
        title.Length > 15 ? title[..14] + "…" : title;

    public void Dispose()
    {
        _projection?.Dispose();
        GC.SuppressFinalize(this);
    }
}
