@page "/editor"
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IVaultHost Vault
@inject WorkspaceSession Workspace
@inject NavigationManager Navigation

<section class="surface editor-surface" data-surface="editor">
    @if (Workspace.CurrentDocument is null)
    {
        <p class="surface-eyebrow">UC-18 · Editor</p>
        <h1>Editor</h1>
        <p class="surface-copy">Abra um arquivo editável pelo Explorer.</p>
        <a class="surface-action" href="explorer">Ir para o Explorer</a>
    }
    else
    {
        var document = Workspace.CurrentDocument;
        var history = Workspace.HistoryStatus;
        var canEditVisual = Workspace.CanEditVisualBlocks;

        @if (Workspace.Tabs.Count > 0)
        {
            <div class="editor-tabs" aria-label="Abas abertas">
                @foreach (var tab in Workspace.Tabs)
                {
                    <div class="editor-tab @(tab.Active ? "active" : null)">
                        <button type="button"
                                class="editor-tab-open"
                                aria-current="@(tab.Active ? "page" : null)"
                                @onclick="() => ActivateTab(tab)">
                            <span>@tab.Title</span>
                        </button>
                        <button type="button"
                                class="editor-tab-pin"
                                aria-label="@($"{(tab.Pinned ? "Desafixar" : "Fixar")} {tab.Title}")"
                                aria-pressed="@(tab.Pinned ? "true" : "false")"
                                title="@(tab.Pinned ? "Desafixar aba" : "Preservar aba ao abrir muitas notas")"
                                @onclick="() => Workspace.PinTab(tab.Id, !tab.Pinned)">
                            <span aria-hidden="true">◆</span>
                        </button>
                        <button type="button"
                                class="editor-tab-close"
                                aria-label="@($"Fechar {tab.Title}")"
                                @onclick="() => CloseTab(tab)">
                            ×
                        </button>
                    </div>
                }
            </div>
        }

        <div class="editor-header">
            <button type="button" class="editor-back" @onclick="Back">← Voltar</button>
            <div class="editor-title">
                <p class="surface-eyebrow">@document.Path</p>
                <h1>@document.Title</h1>
            </div>
            @if (Workspace.IsReadOnly)
            {
                <span class="surface-chip">somente leitura</span>
            }
        </div>

        <div class="editor-reference-layout @(Workspace.References.Entries.Count > 0 ? "has-references" : null)">
        <EditorReferencePanel Entries="Workspace.References.Entries" Changed="RefreshReferences" />
        <div class="editor-reference-main">
        <div class="editor-actions">
            <button type="button" class="editor-pin-reference" @onclick="PinDocument">Fixar nota em painel</button>
            @if (!Workspace.IsReadOnly && ArtifactModel.IsNote(document.Path) &&
                 !NoteTemplateEngine.IsTemplatePath(document.Path))
            {
                <button type="button" class="editor-pin-reference" @onclick="SaveAsTemplate">Salvar como modelo</button>
            }
            @if (_templateStatus is not null)
            {
                <span role="status" class="surface-chip">@_templateStatus</span>
            }
            <div class="editor-history-actions" role="group" aria-label="Histórico do editor">
                <button type="button"
                        disabled="@(!history.CanUndo || Workspace.IsReadOnly)"
                        @onclick="Undo">
                    Desfazer
                </button>
                <button type="button"
                        disabled="@(!history.CanRedo || Workspace.IsReadOnly)"
                        @onclick="Redo">
                    Refazer
                </button>
            </div>

            <div class="editor-mode-switch" role="group" aria-label="Modo do editor">
            <button type="button"
                    class="@ModeClass(EditorSurfaceMode.Visual)"
                    aria-pressed="@(Workspace.Mode == EditorSurfaceMode.Visual)"
                    @onclick="() => SetEditorMode(EditorSurfaceMode.Visual)">
                Visual
            </button>
                <button type="button"
                        class="@ModeClass(EditorSurfaceMode.Source)"
                        aria-pressed="@(Workspace.Mode == EditorSurfaceMode.Source)"
                        @onclick="() => SetEditorMode(EditorSurfaceMode.Source)">
                    Fonte
                </button>
                <button type="button"
                        class="@ModeClass(EditorSurfaceMode.Split)"
                        aria-pressed="@(Workspace.Mode == EditorSurfaceMode.Split)"
                        @onclick="() => SetEditorMode(EditorSurfaceMode.Split)">
                    Dividido
                </button>
            </div>
        </div>

        <div class="editor-stage-layout @(Workspace.Mode == EditorSurfaceMode.Split ? "split" : "")">
        @if (Workspace.Mode != EditorSurfaceMode.Visual)
        {
            <div class="editor-source-container">
                <div class="editor-source-tools" role="toolbar" aria-label="Formatação da fonte Markdown">
                    <button type="button"
                            disabled="@Workspace.IsReadOnly"
                            @onclick="ToggleInlineCode"
                            aria-label="Código em linha">Código em linha</button>
                    <span>Seleção: envolve com crases. Cursor: insere duas crases.</span>
                </div>
                @if (_inlineCodeError is not null)
                {
                    <p class="editor-stage-note" role="alert">@_inlineCodeError</p>
                }
                <label class="editor-source-field">
                    <span class="sr-only">Markdown da nota</span>
                    <textarea @ref="_sourceTextarea"
                              value="@document.Content"
                              disabled="@Workspace.IsReadOnly"
                              @oninput="OnSourceInput"
                              @onkeyup="OnSourceKeyUp"
                              @onclick="OnSourceCaretClicked"
                              spellcheck="true"></textarea>
                </label>
                @if (_wikiContext is not null && Workspace.CurrentDocument is not null)
                {
                    <div class="editor-wikilink-suggestions"
                         role="group" aria-label="Sugestões de links entre notas">
                        <strong>Conectar nota: [[@_wikiContext.Query]]</strong>
                        @foreach (var suggestion in _wikiSuggestions)
                        {
                            <button type="button" disabled="@Workspace.IsReadOnly" @onclick="() => CompleteWikilink(suggestion)">
                                <span>@suggestion.Title</span>
                                <small>@suggestion.Path</small>
                            </button>
                        }
                        @if (CanCreateWikiNote)
                        {
                            <button type="button" class="editor-wikilink-create"
                                    @onclick="CreateWikiNote">
                                + Criar nota "@_wikiContext.Query" e abrir
                            </button>
                        }
                        @if (_wikiSuggestions.Count == 0 && !CanCreateWikiNote)
                        {
                            <span>Nenhuma nota correspondente.</span>
                        }
                    </div>
                }
                @if (_wikiError is not null)
                {
                    <p class="editor-stage-note" role="alert">@_wikiError</p>
                }
            </div>
        }
        @if (Workspace.Mode != EditorSurfaceMode.Source)
        {
            <div class="editor-pane-visual">
            <div class="visual-editor" aria-label="Editor visual">
                <div class="visual-editor-toolbar">
                    <strong>Blocos visuais</strong>
                    <div class="visual-editor-add">
                        <select value="@NewVisualBlockKind" @onchange="ChangeNewVisualBlockKind" aria-label="Tipo do novo bloco">
                            <option value="@VisualBlockKind.Paragraph">Texto</option>
                            <option value="@VisualBlockKind.Heading">Título</option>
                            <option value="@VisualBlockKind.UnorderedList">Lista</option>
                            <option value="@VisualBlockKind.OrderedList">Lista numerada</option>
                            <option value="@VisualBlockKind.Quote">Citação</option>
                            <option value="@VisualBlockKind.Code">Código</option>
                            <option value="@VisualBlockKind.HorizontalRule">Separador</option>
                        </select>
                        <button type="button" @onclick="AddVisualBlock" disabled="@(!canEditVisual)">Adicionar</button>
                    </div>
                </div>

                @if (!canEditVisual && !Workspace.IsReadOnly)
                {
                    <p class="editor-stage-note" role="status">
                        Edição estrutural indisponível para este documento: a conversão alteraria
                        o Markdown original. Use o modo Fonte para preservar a formatação
                        sem perda de conteúdo.
                    </p>
                }

                @if (VisualBlocks.Count == 0)
                {
                    <div class="visual-empty">
                        <strong>Documento vazio</strong>
                        <span>Adicione um bloco ou troque para Fonte para começar.</span>
                    </div>
                }
                else
                {
                    <div class="visual-blocks">
                        @for (var index = 0; index < VisualBlocks.Count; index++)
                        {
                            var blockIndex = index;
                            var block = VisualBlocks[blockIndex];
                            <section class="visual-block visual-block-@block.Kind.ToString().ToLowerInvariant()">
                                <div class="visual-block-toolbar">
                                    <select value="@block.Kind"
                                            @onchange="e => ChangeVisualKind(blockIndex, e)"
                                            disabled="@(!canEditVisual || block.Kind == VisualBlockKind.Raw)"
                                            aria-label="Tipo do bloco">
                                        <option value="@VisualBlockKind.Paragraph">Texto</option>
                                        <option value="@VisualBlockKind.Heading">Título</option>
                                        <option value="@VisualBlockKind.UnorderedList">Lista</option>
                                        <option value="@VisualBlockKind.OrderedList">Lista numerada</option>
                                        <option value="@VisualBlockKind.Quote">Citação</option>
                                        <option value="@VisualBlockKind.Code">Código</option>
                                        <option value="@VisualBlockKind.HorizontalRule">Separador</option>
                                        <option value="@VisualBlockKind.Raw">Avançado</option>
                                    </select>
                                    <span class="visual-block-label">@VisualBlockLabel(block.Kind)</span>
                                    <button type="button" @onclick="() => PinBlock(blockIndex)" aria-label="@($"Fixar trecho {blockIndex + 1} em painel")">Fixar trecho</button>
                                    <button type="button" @onclick="() => MoveVisualBlock(blockIndex, -1)" disabled="@(!canEditVisual || blockIndex == 0)" aria-label="Mover bloco para cima">↑</button>
                                    <button type="button" @onclick="() => MoveVisualBlock(blockIndex, 1)" disabled="@(!canEditVisual || blockIndex == VisualBlocks.Count - 1)" aria-label="Mover bloco para baixo">↓</button>
                                    <button type="button" @onclick="() => RemoveVisualBlock(blockIndex)" disabled="@(!canEditVisual)" aria-label="Excluir bloco">Excluir</button>
                                </div>

                                @if (block.Kind == VisualBlockKind.Heading)
                                {
                                    <div class="visual-block-heading">
                                        <select value="@block.Level"
                                                @onchange="e => ChangeVisualLevel(blockIndex, e)"
                                                disabled="@(!canEditVisual)"
                                                aria-label="Nível do título">
                                            @for (var level = 1; level <= 6; level++)
                                            {
                                                <option value="@level">H@level</option>
                                            }
                                        </select>
                                        <input value="@block.Text"
                                               @onchange="e => ChangeVisualText(blockIndex, e)"
                                               disabled="@(!canEditVisual)"
                                               aria-label="Texto do título"
                                               placeholder="Título" />
                                    </div>
                                }
                                else if (block.Kind == VisualBlockKind.HorizontalRule)
                                {
                                    <div class="visual-rule-preview" aria-label="Separador">––––––––</div>
                                }
                                else if (block.Kind == VisualBlockKind.Code)
                                {
                                    <input class="visual-code-language"
                                           value="@block.Language"
                                           @onchange="e => ChangeVisualLanguage(blockIndex, e)"
                                           disabled="@(!canEditVisual)"
                                           aria-label="Linguagem do código"
                                           placeholder="linguagem opcional" />
                                    <textarea value="@block.Text"
                                              @onchange="e => ChangeVisualText(blockIndex, e)"
                                              disabled="@(!canEditVisual)"
                                              aria-label="Código do bloco"
                                              spellcheck="false"></textarea>
                                }
                                else if (block.Kind == VisualBlockKind.Raw)
                                {
                                    <textarea value="@block.Text"
                                              @onchange="e => ChangeVisualText(blockIndex, e)"
                                              disabled="@(!canEditVisual)"
                                              aria-label="Markdown avançado"
                                              spellcheck="false"></textarea>
                                    <small class="visual-raw-note">Sintaxe avançada preservada como Markdown canônico.</small>
                                }
                                else
                                {
                                    <textarea value="@block.Text"
                                              @onchange="e => ChangeVisualText(blockIndex, e)"
                                              disabled="@(!canEditVisual)"
                                              aria-label="@VisualBlockLabel(block.Kind)"
                                              placeholder="@VisualBlockPlaceholder(block.Kind)"></textarea>
                                }
                            </section>
                        }
                    </div>
                }

                <article class="editor-visual visual-editor-preview" aria-label="Pré-visualização da nota">
                    @((MarkupString)Workspace.PreviewHtml)
                </article>
            </div>
            <p class="editor-stage-note">
                A edição Visual altera o mesmo Markdown canônico usado pelo modo Fonte. Blocos avançados não são reinterpretados silenciosamente.
            </p>
            </div>
        }

        </div>

        <div class="editor-relations">
            <section>
                <h2>Links</h2>
                @if (Workspace.Links().Count == 0 && Workspace.MissingLinks().Count == 0)
                {
                    <p>Nenhum link.</p>
                }
                else
                {
                    @foreach (var linked in Workspace.Links())
                    {
                        <button type="button" @onclick="() => OpenLinked(linked)">@linked.Title</button>
                    }
                    @foreach (var missing in Workspace.MissingLinks())
                    {
                        <button type="button"
                                class="missing-link"
                                disabled="@Workspace.IsReadOnly"
                                @onclick="() => CreateMissingLink(missing)">
                            Criar @missing
                        </button>
                    }
                }
            </section>
            <section>
                <h2>Backlinks</h2>
                @if (Workspace.Backlinks().Count == 0)
                {
                    <p>Nenhum backlink.</p>
                }
                else
                {
                    @foreach (var linked in Workspace.Backlinks())
                    {
                        <button type="button" @onclick="() => OpenLinked(linked)">@linked.Title</button>
                    }
                }
            </section>
        </div>
        </div>
        </div>
    }
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "path")]
    public string? Path { get; set; }

    private void RefreshReferences() => StateHasChanged();

    private string? _templateStatus;

    private void SaveAsTemplate()
    {
        var saved = Workspace.SaveCurrentAsTemplate();
        _templateStatus = saved is null
            ? "Não foi possível criar o modelo."
            : "Modelo criado: " + saved.Path;
    }

    private void PinDocument()
    {
        if (Workspace.CurrentDocument is { } document)
            Workspace.References.PinDocument(document);
    }

    private void PinBlock(int index)
    {
        if (Workspace.CurrentDocument is { } document)
            Workspace.References.PinBlock(document, index);
    }


    private ElementReference _sourceTextarea;
    private IJSObjectReference? _sourceSelectionModule;
    private string? _inlineCodeError;
    private string? _wikiError;
    private WikiLinkCompletion.Context? _wikiContext;
    private string? _wikiDocumentId;
    private string? _wikiMarkdown;
    private IReadOnlyList<UrbeDocument> _wikiSuggestions = [];
    private bool CanCreateWikiNote =>
        !Workspace.IsReadOnly &&
        (!Vault.IsAvailable || Vault.IsConnected) &&
        _wikiContext?.Query.Length > 0;

    private sealed record SourceSelectionSnapshot(string Text, int Start, int End);

    private async Task ToggleInlineCode()
    {
        var original = Workspace.CurrentDocument;
        if (original is null || Workspace.IsReadOnly ||
            Workspace.Mode == EditorSurfaceMode.Visual)
            return;

        try
        {
            _sourceSelectionModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Urbe.UI/editor-source-selection.js");
            var selection = await _sourceSelectionModule.InvokeAsync<SourceSelectionSnapshot?>(
                "capture", _sourceTextarea);

            // Refuse stale DOM values instead of overwriting concurrent edits.
            if (selection is null ||
                !string.Equals(selection.Text, original.Content, StringComparison.Ordinal) ||
                Workspace.CurrentDocument?.Id != original.Id ||
                !string.Equals(Workspace.CurrentDocument?.Content, original.Content, StringComparison.Ordinal))
            {
                _inlineCodeError = "O editor mudou durante o comando. Tente novamente.";
                return;
            }

            var changed = InlineCodeEditing.Toggle(
                original.Content, selection.Start, selection.End);
            if (changed is null)
            {
                _inlineCodeError = "Selecione texto de uma única linha para código em linha.";
                return;
            }

            if (Workspace.UpdateSource(changed.Markdown) is null)
                return;

            _inlineCodeError = null;
            if (Workspace.Mode == EditorSurfaceMode.Split)
                SyncVisualModel();

            await _sourceSelectionModule.InvokeVoidAsync(
                "restore", _sourceTextarea, changed.Markdown,
                changed.SelectionStart, changed.SelectionEnd);
        }
        catch (JSDisconnectedException)
        {
            _inlineCodeError = "Editor indisponível durante a navegação.";
        }
        catch (JSException)
        {
            _inlineCodeError = "Não foi possível acessar a seleção do editor.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_sourceSelectionModule is null)
            return;
        try
        {
            await _sourceSelectionModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The native WebView or browser circuit is already gone.
        }
    }

    private async Task OnSourceInput(ChangeEventArgs args)
    {
        _inlineCodeError = null;
        _wikiError = null;
        Workspace.UpdateSource(args.Value?.ToString() ?? string.Empty);
        if (Workspace.Mode == EditorSurfaceMode.Split)
            SyncVisualModel();
        await RefreshWikiSuggestionsAsync();
    }

    private Task OnSourceKeyUp(KeyboardEventArgs _) => RefreshWikiSuggestionsAsync();
    private Task OnSourceCaretClicked(MouseEventArgs _) => RefreshWikiSuggestionsAsync();

    private void ClearWikiSuggestions()
    {
        _wikiContext = null;
        _wikiDocumentId = null;
        _wikiMarkdown = null;
        _wikiSuggestions = [];
    }

    private async Task RefreshWikiSuggestionsAsync()
    {
        var document = Workspace.CurrentDocument;
        if (document is null || Workspace.Mode == EditorSurfaceMode.Visual)
        {
            ClearWikiSuggestions();
            return;
        }

        try
        {
            _sourceSelectionModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Urbe.UI/editor-source-selection.js");
            var captured = await _sourceSelectionModule.InvokeAsync<SourceSelectionSnapshot?>(
                "capture", _sourceTextarea);
            if (captured is null || captured.Start != captured.End ||
                !string.Equals(captured.Text, document.Content, StringComparison.Ordinal) ||
                Workspace.CurrentDocument?.Id != document.Id)
            {
                ClearWikiSuggestions();
                return;
            }

            _wikiContext = WikiLinkCompletion.Find(captured.Text, captured.Start);
            _wikiDocumentId = _wikiContext is null ? null : document.Id;
            _wikiMarkdown = _wikiContext is null ? null : captured.Text;
            _wikiSuggestions = _wikiContext is null
                ? []
                : Workspace.Documents.List()
                    .Where(note => ArtifactModel.IsNote(note.Path) &&
                        note.Id != document.Id &&
                        (note.Title.Contains(_wikiContext.Query, StringComparison.OrdinalIgnoreCase) ||
                         ArtifactModel.WithoutNoteExtension(note.Path)
                             .Contains(_wikiContext.Query, StringComparison.OrdinalIgnoreCase)))
                    .OrderBy(note => note.Title, StringComparer.OrdinalIgnoreCase)
                    .ThenBy(note => note.Path, StringComparer.OrdinalIgnoreCase)
                    .Take(6).ToArray();
        }
        catch (JSDisconnectedException)
        {
            ClearWikiSuggestions();
        }
        catch (JSException)
        {
            ClearWikiSuggestions();
        }
    }

    private async Task CompleteWikilink(UrbeDocument suggestion)
    {
        if (Workspace.CurrentDocument is not { } document ||
            _wikiContext is null || _wikiDocumentId != document.Id ||
            !string.Equals(_wikiMarkdown, document.Content, StringComparison.Ordinal))
        {
            ClearWikiSuggestions();
            _wikiError = "A nota mudou. Reabra as sugestões antes de inserir o link.";
            return;
        }

        var result = WikiLinkCompletion.Complete(
            document.Content, _wikiContext,
            ArtifactModel.WithoutNoteExtension(suggestion.Path));
        if (result is null || Workspace.UpdateSource(result.Markdown) is null)
        {
            _wikiError = "Não foi possível inserir o link.";
            return;
        }

        ClearWikiSuggestions();
        _wikiError = null;
        if (Workspace.Mode == EditorSurfaceMode.Split)
            SyncVisualModel();
        try
        {
            await _sourceSelectionModule!.InvokeVoidAsync(
                "restore", _sourceTextarea, result.Markdown,
                result.Cursor, result.Cursor);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private async Task CreateWikiNote()
    {
        if (!CanCreateWikiNote || Workspace.CurrentDocument is not { } source ||
            _wikiContext is null || _wikiDocumentId != source.Id ||
            !string.Equals(_wikiMarkdown, source.Content, StringComparison.Ordinal))
        {
            ClearWikiSuggestions();
            _wikiError = "A nota mudou ou a pasta não está conectada.";
            return;
        }

        var context = _wikiContext;
        var created = Workspace.CreateLinkedNote(context.Query);
        if (created is null)
        {
            _wikiError = "Não foi possível criar a nota vinculada.";
            return;
        }

        var result = WikiLinkCompletion.Complete(
            source.Content, context, ArtifactModel.WithoutNoteExtension(created.Path));
        if (result is null || Workspace.UpdateSource(result.Markdown) is null)
        {
            _wikiError = "A nota vinculada foi criada, mas o link não pôde ser inserido.";
            return;
        }

        ClearWikiSuggestions();
        _wikiError = null;
        if (!Workspace.Open(created.Id, new EditorOpenOrigin(
            EditorOpenOriginKind.Link,
            "editor?path=" + Uri.EscapeDataString(source.Path))))
            return;
        Navigation.NavigateTo("editor?path=" + Uri.EscapeDataString(created.Path));
        await Task.CompletedTask;
    }

    private void Undo()
    {
        Workspace.Undo();
        ClearWikiSuggestions();
        SyncVisualModel();
    }

    private void Redo()
    {
        Workspace.Redo();
        ClearWikiSuggestions();
        SyncVisualModel();
    }

    private void ActivateTab(EditorWorkspaceTab tab)
    {
        if (!Workspace.ActivateTab(tab.Id))
            return;

        Navigation.NavigateTo(
            "editor?path=" + Uri.EscapeDataString(tab.Path));
    }

    private void CloseTab(EditorWorkspaceTab tab)
    {
        var wasActive = tab.Active;
        if (!Workspace.CloseTab(tab.Id))
            return;

        if (!wasActive)
            return;

        if (Workspace.CurrentDocument is null)
        {
            Navigation.NavigateTo("explorer");
            return;
        }

        Navigation.NavigateTo(
            "editor?path=" + Uri.EscapeDataString(Workspace.CurrentDocument.Path));
    }

    private void Back()
    {
        Workspace.TryPopOrigin(out var origin);
        Navigation.NavigateTo(origin.Href);
    }

    private void CreateMissingLink(string target)
    {
        var current = Workspace.CurrentDocument;
        if (current is null)
            return;

        var created = Workspace.CreateLinkedNote(target);
        if (created is null)
            return;

        var returnHref =
            "editor?path=" + Uri.EscapeDataString(current.Path);

        if (!Workspace.Open(
                created.Id,
                new EditorOpenOrigin(EditorOpenOriginKind.Link, returnHref)))
            return;

        Navigation.NavigateTo(
            "editor?path=" + Uri.EscapeDataString(created.Path));
    }

    private void OpenLinked(UrbeDocument document)
    {
        var current = Workspace.CurrentDocument;
        if (current is null)
            return;

        var returnHref =
            "editor?path=" + Uri.EscapeDataString(current.Path);

        if (!Workspace.Open(
                document.Id,
                new EditorOpenOrigin(EditorOpenOriginKind.Link, returnHref)))
            return;

        Navigation.NavigateTo(
            "editor?path=" + Uri.EscapeDataString(document.Path));
    }

    private List<VisualBlock> VisualBlocks { get; } = [];
    private string VisualFrontmatter { get; set; } = string.Empty;
    private VisualBlockKind NewVisualBlockKind { get; set; } = VisualBlockKind.Paragraph;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Path))
            return;

        if (Workspace.CurrentDocument is null ||
            !string.Equals(
                Workspace.CurrentDocument.Path,
                DocumentModel.NormalizePath(Path),
                StringComparison.OrdinalIgnoreCase))
        {
            ClearWikiSuggestions();
            Workspace.Restore(Path);
        }

        SyncVisualModel();
    }

    private void SyncVisualModel()
    {
        var model = Workspace.VisualModel;
        VisualFrontmatter = model.Frontmatter;
        VisualBlocks.Clear();
        VisualBlocks.AddRange(model.Blocks);
    }

    private void SetEditorMode(EditorSurfaceMode mode)
    {
        ClearWikiSuggestions();
        if (mode != EditorSurfaceMode.Source)
            SyncVisualModel();

        Workspace.SetMode(mode);
    }

    private void ChangeNewVisualBlockKind(ChangeEventArgs args)
    {
        if (Enum.TryParse<VisualBlockKind>(args.Value?.ToString(), out var kind))
            NewVisualBlockKind = kind;
    }

    private void AddVisualBlock()
    {
        if (!Workspace.CanEditVisualBlocks)
            return;

        var block = NewVisualBlockKind switch
        {
            VisualBlockKind.Heading => new VisualBlock(VisualBlockKind.Heading, "Título", 1),
            VisualBlockKind.UnorderedList => new VisualBlock(VisualBlockKind.UnorderedList, "Item 1"),
            VisualBlockKind.OrderedList => new VisualBlock(VisualBlockKind.OrderedList, "Item 1"),
            VisualBlockKind.Quote => new VisualBlock(VisualBlockKind.Quote, "Citação"),
            VisualBlockKind.Code => new VisualBlock(VisualBlockKind.Code, string.Empty, Language: "csharp"),
            VisualBlockKind.HorizontalRule => new VisualBlock(VisualBlockKind.HorizontalRule, string.Empty),
            _ => new VisualBlock(VisualBlockKind.Paragraph, "Texto")
        };

        VisualBlocks.Add(block);
        CommitVisualChanges();
    }

    private void RemoveVisualBlock(int index)
    {
        if (!Workspace.CanEditVisualBlocks || index < 0 || index >= VisualBlocks.Count)
            return;

        VisualBlocks.RemoveAt(index);
        CommitVisualChanges();
    }

    private void MoveVisualBlock(int index, int delta)
    {
        if (!Workspace.CanEditVisualBlocks)
            return;

        var target = index + delta;
        if (index < 0 || index >= VisualBlocks.Count || target < 0 || target >= VisualBlocks.Count)
            return;

        (VisualBlocks[index], VisualBlocks[target]) = (VisualBlocks[target], VisualBlocks[index]);
        CommitVisualChanges();
    }

    private void ChangeVisualKind(int index, ChangeEventArgs args)
    {
        if (!Workspace.CanEditVisualBlocks || index < 0 || index >= VisualBlocks.Count)
            return;

        if (!Enum.TryParse<VisualBlockKind>(args.Value?.ToString(), out var kind))
            return;

        var block = VisualBlocks[index];
        if (block.Kind == VisualBlockKind.Raw)
            return;

        var replacement = kind switch
        {
            VisualBlockKind.Heading => block with { Kind = kind, Level = Math.Clamp(block.Level, 1, 6) },
            VisualBlockKind.Code => block with { Kind = kind, Language = string.IsNullOrWhiteSpace(block.Language) ? "csharp" : block.Language },
            _ => block with { Kind = kind }
        };

        VisualBlocks[index] = replacement;
        CommitVisualChanges();
    }

    private void ChangeVisualLevel(int index, ChangeEventArgs args)
    {
        if (!Workspace.CanEditVisualBlocks || index < 0 || index >= VisualBlocks.Count)
            return;

        if (int.TryParse(args.Value?.ToString(), out var level))
        {
            VisualBlocks[index] = VisualBlocks[index] with { Level = Math.Clamp(level, 1, 6) };
            CommitVisualChanges();
        }
    }

    private void ChangeVisualLanguage(int index, ChangeEventArgs args)
    {
        if (!Workspace.CanEditVisualBlocks || index < 0 || index >= VisualBlocks.Count)
            return;

        VisualBlocks[index] = VisualBlocks[index] with { Language = args.Value?.ToString() ?? string.Empty };
        CommitVisualChanges();
    }

    private void ChangeVisualText(int index, ChangeEventArgs args)
    {
        if (!Workspace.CanEditVisualBlocks || index < 0 || index >= VisualBlocks.Count)
            return;

        VisualBlocks[index] = VisualBlocks[index] with { Text = args.Value?.ToString() ?? string.Empty };
        CommitVisualChanges();
    }

    private void CommitVisualChanges()
    {
        if (!Workspace.CanEditVisualBlocks)
            return;

        Workspace.UpdateVisualBlocks(VisualFrontmatter, VisualBlocks);
        SyncVisualModel();
    }

    private static string VisualBlockLabel(VisualBlockKind kind) =>
        kind switch
        {
            VisualBlockKind.Paragraph => "Texto",
            VisualBlockKind.Heading => "Título",
            VisualBlockKind.UnorderedList => "Lista",
            VisualBlockKind.OrderedList => "Lista numerada",
            VisualBlockKind.Quote => "Citação",
            VisualBlockKind.Code => "Código",
            VisualBlockKind.HorizontalRule => "Separador",
            VisualBlockKind.Raw => "Avançado",
            _ => kind.ToString()
        };

    private static string VisualBlockPlaceholder(VisualBlockKind kind) =>
        kind switch
        {
            VisualBlockKind.Paragraph => "Escreva o texto…",
            VisualBlockKind.UnorderedList => "Um item por linha…",
            VisualBlockKind.OrderedList => "Um item por linha…",
            VisualBlockKind.Quote => "Escreva a citação…",
            _ => "Conteúdo…"
        };

    private string ModeClass(EditorSurfaceMode mode) =>
        Workspace.Mode == mode
            ? "editor-mode active"
            : "editor-mode";
}
