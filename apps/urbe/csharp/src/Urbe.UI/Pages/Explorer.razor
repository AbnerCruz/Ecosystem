@page "/explorer"
@implements IDisposable
@inject WorkspaceSession Workspace
@inject NavigationManager Navigation

<section class="surface explorer-surface" data-surface="explorer">
    <div class="surface-toolbar">
        <div>
            <p class="surface-eyebrow">UC-18 · Explorer</p>
            <h1>Explorer</h1>
        </div>
        <span class="surface-chip">@Workspace.Paths.Count arquivo(s)</span>
    </div>

    <p class="surface-copy">
        Arquivos do vault sobre a sessão C# compartilhada. Arraste no desktop ou mantenha pressionado no toque
        para armar um movimento; nenhuma escrita física acontece fora do adapter canônico do host.
    </p>

    <div class="explorer-controls">
        <label class="field">
            <span>Buscar</span>
            <input value="@Query" @oninput="OnQueryInput" placeholder="nome ou caminho" />
        </label>

        <div class="new-note">
            <label class="field">
                <span>Nova nota</span>
                <input value="@NewNoteTitle"
                       @oninput="OnNewNoteTitleInput"
                       placeholder="Título"
                       disabled="@Workspace.IsReadOnly" />
            </label>
            <button type="button"
                    class="surface-action"
                    disabled="@Workspace.IsReadOnly"
                    @onclick="CreateNote">
                Criar
            </button>
        </div>

        <div class="new-note">
            <label class="field">
                <span>Modelo da nota (opcional)</span>
                <select value="@SelectedTemplatePath"
                        @onchange="OnTemplateSelected"
                        disabled="@Workspace.IsReadOnly"
                        aria-label="Selecionar modelo de nota">
                    <option value="">Nota em branco</option>
                    @foreach (var template in Workspace.Templates)
                    {
                        <option value="@template.Path">@template.Title (@template.Path)</option>
                    }
                </select>
            </label>
        </div>

        @if (SelectedTemplate is { } selectedTemplate)
        {
            var fields = NoteTemplateEngine.Fields(selectedTemplate.Content);
            @if (fields.Count > NoteTemplateEngine.MaxFields)
            {
                <p role="alert">Este modelo excede o limite de @NoteTemplateEngine.MaxFields campos.</p>
            }
            else if (fields.Count > 0)
            {
                <div class="explorer-template-fields" aria-label="Campos do modelo">
                    @foreach (var field in fields)
                    {
                        <label class="field">
                            <span>@field</span>
                            <input value="@GetTemplateField(field)"
                                   @oninput="args => SetTemplateField(field, args)"
                                   disabled="@Workspace.IsReadOnly" />
                        </label>
                    }
                </div>
            }
        }

        <div class="new-note">
            <label class="field">
                <span>Nova pasta</span>
                <input value="@NewFolderName"
                       @oninput="OnNewFolderNameInput"
                       placeholder="Nome"
                       disabled="@Workspace.IsReadOnly" />
            </label>
            <button type="button"
                    class="surface-action"
                    disabled="@Workspace.IsReadOnly"
                    @onclick="CreateFolder">
                Criar pasta
            </button>
        </div>
    </div>

    @if (_createError is not null)
    {
        <p class="explorer-create-error" role="alert">@_createError</p>
    }

    <div class="explorer-location"
         @ondragover:preventDefault
         @ondrop="MoveToCurrentFolder">
        <span>Local atual</span>
        <strong>@CurrentFolderLabel</strong>
        @if (_moveSource is not null)
        {
            <button type="button"
                    disabled="@Workspace.IsReadOnly"
                    @onclick="MoveArmedToCurrentFolder">
                Mover aqui
            </button>
        }
    </div>

    @if (_moveSource is not null)
    {
        <div class="explorer-move-banner" role="status">
            <span>Movendo <strong>@FileName(_moveSource)</strong></span>
            <button type="button" @onclick="CancelMove">Cancelar</button>
        </div>
    }

    @if (Workspace.CurrentFolder.Length > 0 && Query.Length == 0)
    {
        <button type="button" class="folder-back" @onclick="GoParent">
            ← @ParentLabel
        </button>
    }

    @if (_selectedFolder is not null)
    {
        <div class="explorer-folder-actions" aria-label="@($"Ações de {_selectedFolder.Name}")">
            <div>
                <strong>@_selectedFolder.Name</strong>
                <span>@_selectedFolder.Path</span>
            </div>
            <button type="button" @onclick="OpenSelectedFolder">Abrir pasta</button>
            <button type="button"
                    disabled="@Workspace.IsReadOnly"
                    @onclick="CreateNoteInSelectedFolder">
                Nova nota aqui
            </button>
            @if (_moveSource is not null &&
                 !string.Equals(_moveSource, _selectedFolder.Path, StringComparison.OrdinalIgnoreCase))
            {
                <button type="button"
                        disabled="@Workspace.IsReadOnly"
                        @onclick="MoveArmedToSelectedFolder">
                    Mover para cá
                </button>
            }
        </div>
    }

    @{
        var entries = Workspace.ExplorerEntries(Workspace.CurrentFolder, Query);
    }

    @if (entries.Count == 0)
    {
        <div class="surface-planned" role="status">
            @if (Workspace.Paths.Count == 0 && Workspace.Folders.Count == 0)
            {
                <strong>Nenhum vault conectado</strong>
                <span>A superfície está funcional; os hosts ainda precisam entregar um <code>VaultSnapshot</code> à sessão.</span>
            }
            else
            {
                <strong>Nenhum resultado</strong>
                <span>Não há arquivo correspondente neste contexto.</span>
            }
        </div>
    }
    else
    {
        <div class="explorer-list" aria-label="Arquivos do vault">
            @foreach (var entry in entries)
            {
                <button type="button"
                        class="@RowClass(entry)"
                        data-path="@entry.Path"
                        draggable="@(Workspace.IsReadOnly ? "false" : "true")"
                        disabled="@(!entry.IsFolder && !entry.Editable)"
                        @onclick="() => Activate(entry)"
                        @ondragstart="() => BeginDrag(entry.Path)"
                        @ondragend="EndDrag"
                        @ondragover:preventDefault
                        @ondrop="() => DropOn(entry)"
                        @onpointerdown="() => BeginLongPress(entry)"
                        @onpointerup="CancelLongPress"
                        @onpointercancel="CancelLongPress"
                        @onpointerleave="CancelLongPress">
                    <span class="explorer-kind" aria-hidden="true">@(entry.IsFolder ? "▣" : "•")</span>
                    <span class="explorer-main">
                        <strong>@entry.Name</strong>
                        <small>@EntryMeta(entry)</small>
                    </span>
                    <span class="explorer-open" aria-hidden="true">@(entry.IsFolder ? "…" : entry.Editable ? "↗" : "")</span>
                </button>
            }
        </div>
    }

    @if (Workspace.PendingMutations.Count > 0)
    {
        <p class="explorer-pending">
            @Workspace.PendingMutations.Count alteração(ões) aguardando persistência pelo host.
        </p>
    }
</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "folder")]
    public string? FolderFromNavigation { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "query")]
    public string? QueryFromNavigation { get; set; }

    private string Query { get; set; } = string.Empty;
    private string NewNoteTitle { get; set; } = string.Empty;
    private string NewFolderName { get; set; } = string.Empty;
    private string SelectedTemplatePath { get; set; } = string.Empty;
    private readonly Dictionary<string, string?> _templateValues = new(StringComparer.Ordinal);
    private string? _createError;

    private UrbeDocument? SelectedTemplate =>
        Workspace.Templates.FirstOrDefault(
            template => string.Equals(
                template.Path, SelectedTemplatePath,
                StringComparison.OrdinalIgnoreCase));
    private WorkspaceExplorerEntry? _selectedFolder;
    private string? _dragSource;
    private string? _moveSource;
    private string? _suppressClickPath;
    private CancellationTokenSource? _longPressCancellation;

    protected override void OnParametersSet()
    {
        if (FolderFromNavigation is not null)
            Workspace.SetFolder(FolderFromNavigation);

        if (QueryFromNavigation is not null)
            Query = QueryFromNavigation;
    }

    public void Dispose()
    {
        CancelLongPress();
        GC.SuppressFinalize(this);
    }

    private string CurrentFolderLabel =>
        Workspace.CurrentFolder.Length == 0
            ? "Raiz"
            : Workspace.CurrentFolder;

    private string ParentLabel
    {
        get
        {
            var slash = Workspace.CurrentFolder.LastIndexOf('/');
            return slash < 0 ? "Raiz" : Workspace.CurrentFolder[..slash];
        }
    }

    private void OnQueryInput(ChangeEventArgs args)
    {
        Query = args.Value?.ToString() ?? string.Empty;
        _selectedFolder = null;
    }

    private void OnNewNoteTitleInput(ChangeEventArgs args) =>
        NewNoteTitle = args.Value?.ToString() ?? string.Empty;

    private void OnNewFolderNameInput(ChangeEventArgs args) =>
        NewFolderName = args.Value?.ToString() ?? string.Empty;

    private void OnTemplateSelected(ChangeEventArgs args)
    {
        SelectedTemplatePath = args.Value?.ToString() ?? string.Empty;
        _templateValues.Clear();
        _createError = null;
        if (SelectedTemplate is { } selected)
        {
            foreach (var field in NoteTemplateEngine.Fields(selected.Content))
                _templateValues[field] = string.Empty;
        }
    }

    private string GetTemplateField(string name) =>
        _templateValues.GetValueOrDefault(name) ?? string.Empty;

    private void SetTemplateField(string name, ChangeEventArgs args)
    {
        _templateValues[name] = args.Value?.ToString() ?? string.Empty;
        _createError = null;
    }

    private UrbeDocument? CreateWithSelectedTemplate(string? title, string? folder)
    {
        if (SelectedTemplatePath.Length == 0)
            return Workspace.CreateNote(title, folder);

        return SelectedTemplate is { } template
            ? Workspace.CreateFromTemplate(template.Path, title, folder, _templateValues)
            : null;
    }

    private void Activate(WorkspaceExplorerEntry entry)
    {
        if (string.Equals(
                _suppressClickPath,
                entry.Path,
                StringComparison.OrdinalIgnoreCase))
        {
            _suppressClickPath = null;
            return;
        }

        if (_moveSource is not null && entry.IsFolder)
        {
            Move(_moveSource, entry.Path);
            return;
        }

        if (entry.IsFolder)
        {
            _selectedFolder =
                string.Equals(
                    _selectedFolder?.Path,
                    entry.Path,
                    StringComparison.OrdinalIgnoreCase)
                    ? null
                    : entry;
            return;
        }

        OpenDocument(entry);
    }

    private void OpenDocument(WorkspaceExplorerEntry entry)
    {
        if (!entry.Editable)
            return;

        if (!Workspace.Open(
                entry.Path,
                new EditorOpenOrigin(EditorOpenOriginKind.Explorer, ExplorerHref())))
            return;

        Navigation.NavigateTo(
            "editor?path=" + Uri.EscapeDataString(entry.Path));
    }

    private void OpenSelectedFolder()
    {
        if (_selectedFolder is null)
            return;

        Workspace.SetFolder(_selectedFolder.Path);
        _selectedFolder = null;
        Query = string.Empty;
    }

    private void GoParent()
    {
        var slash = Workspace.CurrentFolder.LastIndexOf('/');
        Workspace.SetFolder(slash < 0 ? string.Empty : Workspace.CurrentFolder[..slash]);
        _selectedFolder = null;
    }

    private void CreateNote()
    {
        var document = CreateWithSelectedTemplate(
            NewNoteTitle,
            Workspace.CurrentFolder);

        if (document is null)
        {
            _createError = "Não foi possível criar a nota. Confira o modelo, os campos e a pasta.";
            return;
        }
        _createError = null;

        Workspace.Open(
            document.Id,
            new EditorOpenOrigin(EditorOpenOriginKind.Explorer, ExplorerHref()));

        NewNoteTitle = string.Empty;
        _selectedFolder = null;
        Navigation.NavigateTo(
            "editor?path=" + Uri.EscapeDataString(document.Path));
    }

    private void CreateNoteInSelectedFolder()
    {
        if (_selectedFolder is null)
            return;

        var title = string.IsNullOrWhiteSpace(NewNoteTitle)
            ? "Nova nota"
            : NewNoteTitle;

        var document = CreateWithSelectedTemplate(
            title,
            _selectedFolder.Path);

        if (document is null)
        {
            _createError = "Não foi possível criar a nota nesta pasta com este modelo.";
            return;
        }
        _createError = null;

        Workspace.Open(
            document.Id,
            new EditorOpenOrigin(EditorOpenOriginKind.Explorer, ExplorerHref()));

        NewNoteTitle = string.Empty;
        Navigation.NavigateTo(
            "editor?path=" + Uri.EscapeDataString(document.Path));
    }

    private void CreateFolder()
    {
        var created = Workspace.CreateFolder(
            NewFolderName,
            Workspace.CurrentFolder);

        if (created is null)
            return;

        NewFolderName = string.Empty;
        _selectedFolder = Workspace
            .ExplorerEntries(Workspace.CurrentFolder)
            .FirstOrDefault(
                entry =>
                    entry.IsFolder &&
                    string.Equals(
                        entry.Path,
                        created,
                        StringComparison.OrdinalIgnoreCase));
    }

    private void BeginDrag(string path)
    {
        if (Workspace.IsReadOnly)
            return;

        // Desktop drag should not arm the touch move banner. That banner
        // inserts layout above the drop target while Chromium is dragging,
        // invalidating the pointer coordinates used by Playwright and users.
        _dragSource = path;
    }

    private void EndDrag()
    {
        _dragSource = null;
    }

    private void DropOn(WorkspaceExplorerEntry entry)
    {
        if (!entry.IsFolder || _dragSource is null)
            return;

        Move(_dragSource, entry.Path);
    }

    private void MoveToCurrentFolder()
    {
        if (_dragSource is null)
            return;

        Move(_dragSource, Workspace.CurrentFolder);
    }

    private void MoveArmedToCurrentFolder()
    {
        if (_moveSource is null)
            return;

        Move(_moveSource, Workspace.CurrentFolder);
    }

    private void MoveArmedToSelectedFolder()
    {
        if (_moveSource is null || _selectedFolder is null)
            return;

        Move(_moveSource, _selectedFolder.Path);
    }

    private void Move(string source, string targetFolder)
    {
        if (!Workspace.MoveItem(source, targetFolder))
            return;

        _dragSource = null;
        _moveSource = null;
        _suppressClickPath = null;
        _selectedFolder = null;
    }

    private async Task BeginLongPress(WorkspaceExplorerEntry entry)
    {
        if (Workspace.IsReadOnly)
            return;

        CancelLongPress();
        var cancellation = new CancellationTokenSource();
        _longPressCancellation = cancellation;

        try
        {
            await Task.Delay(550, cancellation.Token);
            if (cancellation.IsCancellationRequested)
                return;

            _moveSource = entry.Path;
            _suppressClickPath = entry.Path;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelLongPress()
    {
        _longPressCancellation?.Cancel();
        _longPressCancellation?.Dispose();
        _longPressCancellation = null;
    }

    private void CancelMove()
    {
        _dragSource = null;
        _moveSource = null;
        _suppressClickPath = null;
    }

    private string ExplorerHref()
    {
        var parts = new List<string>();
        if (Workspace.CurrentFolder.Length > 0)
            parts.Add("folder=" + Uri.EscapeDataString(Workspace.CurrentFolder));
        if (Query.Length > 0)
            parts.Add("query=" + Uri.EscapeDataString(Query));

        return parts.Count == 0
            ? "explorer"
            : "explorer?" + string.Join("&", parts);
    }

    private string RowClass(WorkspaceExplorerEntry entry)
    {
        var selected =
            entry.IsFolder &&
            string.Equals(
                _selectedFolder?.Path,
                entry.Path,
                StringComparison.OrdinalIgnoreCase);

        var moving =
            string.Equals(
                _moveSource,
                entry.Path,
                StringComparison.OrdinalIgnoreCase);

        return "explorer-row" +
               (selected ? " selected" : string.Empty) +
               (moving ? " moving" : string.Empty);
    }

    private static string FileName(string path)
    {
        var slash = path.LastIndexOf('/');
        return slash >= 0 ? path[(slash + 1)..] : path;
    }

    private static string EntryMeta(WorkspaceExplorerEntry entry)
    {
        if (entry.IsFolder)
            return "pasta";

        var kind = entry.Type?.ToString().ToLowerInvariant() ?? "arquivo";
        return entry.Extension.Length == 0
            ? kind
            : kind + " · " + entry.Extension;
    }
}
