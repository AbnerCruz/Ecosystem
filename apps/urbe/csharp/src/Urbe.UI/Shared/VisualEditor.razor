@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<article @ref="_root"
         class="editor-visual editor-visual-editable"
         aria-label="Editor visual da nota"
         contenteditable="@(!ReadOnly ? "true" : "false")"
         spellcheck="true"
         @oninput="OnInputAsync"
         @onblur="OnBlurAsync">
</article>

@code {
    [Parameter, EditorRequired]
    public string Html { get; set; } = string.Empty;

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public EventCallback<string> HtmlChanged { get; set; }

    private ElementReference _root;
    private IJSObjectReference? _module;
    private string? _lastEmittedHtml;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./_content/Urbe.UI/editor-dom.js");

        await _module.InvokeVoidAsync(
            "syncHtml",
            _root,
            Html,
            true);
    }

    private async Task OnInputAsync()
    {
        if (ReadOnly)
            return;

        var html = await ReadHtmlAsync();
        if (string.Equals(html, _lastEmittedHtml, StringComparison.Ordinal))
            return;

        _lastEmittedHtml = html;
        await HtmlChanged.InvokeAsync(html);
    }

    private async Task OnBlurAsync()
    {
        if (ReadOnly)
            return;

        await OnInputAsync();

        if (_module is not null)
        {
            await _module.InvokeVoidAsync(
                "syncHtml",
                _root,
                Html,
                false);
        }
    }

    private async ValueTask<string> ReadHtmlAsync()
    {
        if (_module is null)
            return Html;

        return await _module.InvokeAsync<string>(
            "readHtml",
            _root);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
            return;

        try
        {
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Host/window closed during disposal.
        }
    }
}
