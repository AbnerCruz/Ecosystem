@implements IDisposable
@inject IVaultHost Host
@inject WorkspaceSession Workspace

@if (Host.IsAvailable)
{
    <section class="vault-host-controls" aria-label="Pasta física do vault">
        <div class="vault-host-actions">
            <button type="button" @onclick="Pick" disabled="@_busy">
                @(Host.IsConnected ? (_confirmSwitch ? "Confirmar troca" : "Trocar pasta") : "Selecionar pasta do vault")
            </button>
            <button type="button" @onclick="Save" disabled="@(_busy || !Host.IsConnected || Workspace.IsReadOnly)">
                Salvar arquivos
            </button>
            <span role="status">@(_busy ? "Acessando pasta..." :
                Host.IsConnected ? Host.DisplayName : "Nenhuma pasta conectada")</span>
            @if (Host.IsConnected && Workspace.HasUnsavedChanges)
            {
                <span class="vault-unsaved" role="status">Alterações ainda não salvas</span>
            }
        </div>
        @if (_message is not null)
        {
            <p role="status" class="vault-host-status">@_message</p>
        }
        @if (_error is not null)
        {
            <p role="alert" class="vault-host-error">@_error</p>
        }
    </section>
}

@code {
    private const int AutoSaveDelayMilliseconds = 1600;
    private bool _busy;
    private bool _disposed;
    private bool _confirmSwitch;
    private bool _changedWhileBusy;
    private string? _error;
    private string? _message;
    private CancellationTokenSource? _scheduledSave;

    protected override async Task OnInitializedAsync()
    {
        Workspace.PersistenceChanged += OnPersistenceChanged;
        if (!Host.IsAvailable)
            return;
        try
        {
            var restored = await Host.RestoreAsync();
            if (restored is not null)
            {
                Workspace.Load(restored, Host.Folders);
                _message = "Pasta reaberta. O salvamento automático só atua após edições; o botão Salvar continua disponível.";
            }
        }
        catch (Exception exception)
        {
            _error = "Não foi possível reabrir a pasta: " + exception.Message;
        }
    }

    private void OnPersistenceChanged(object? sender, EventArgs args)
    {
        if (_disposed)
            return;

        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;

            if (_busy)
            {
                _changedWhileBusy = true;
            }
            else if (Host.IsConnected && !Workspace.IsReadOnly &&
                     Workspace.HasUnsavedChanges)
            {
                ScheduleAutoSave();
            }
            else
            {
                CancelAutoSave();
            }
            StateHasChanged();
        });
    }

    private void CancelAutoSave()
    {
        var previous = _scheduledSave;
        _scheduledSave = null;
        if (previous is null)
            return;
        previous.Cancel();
        previous.Dispose();
    }

    private void ScheduleAutoSave()
    {
        CancelAutoSave();
        if (_disposed || !Host.IsConnected || Workspace.IsReadOnly ||
            !Workspace.HasUnsavedChanges)
            return;

        var scheduled = new CancellationTokenSource();
        _scheduledSave = scheduled;
        _ = RunAutoSaveAsync(scheduled.Token);
    }

    private async Task RunAutoSaveAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(AutoSaveDelayMilliseconds, cancellationToken);
            await InvokeAsync(async () =>
            {
                if (_disposed || cancellationToken.IsCancellationRequested ||
                    !Host.IsConnected || !Workspace.HasUnsavedChanges ||
                    Workspace.IsReadOnly)
                    return;

                await SaveCoreAsync(automatic: true);
                StateHasChanged();
            });
        }
        catch (OperationCanceledException)
        {
            // Another edit or a manual Save replaced this pending attempt.
        }
        catch (Exception exception)
        {
            if (_disposed)
                return;
            await InvokeAsync(() =>
            {
                _error = "Falha no salvamento automático: " + exception.Message;
                StateHasChanged();
            });
        }
    }

    private async Task Pick()
    {
        if (_busy)
            return;

        if (Host.IsConnected && !_confirmSwitch)
        {
            // Merely opening the confirmation must not cancel a queued save.
            // The user can ignore the prompt without silently losing edits.
            _confirmSwitch = true;
            _error = null;
            _message = "Trocar a pasta descarta alterações ainda não salvas. " +
                       "Salve primeiro ou toque em Confirmar troca para continuar.";
            return;
        }

        _busy = true;
        CancelAutoSave();
        _error = null;
        _message = null;
        try
        {
            var snapshot = await Host.PickAsync();
            if (snapshot is null)
            {
                _confirmSwitch = false;
                _message = "Seleção cancelada; os documentos abertos não foram alterados.";
                return;
            }
            Workspace.Load(snapshot, Host.Folders);
            _confirmSwitch = false;
            _message = snapshot.IsReadOnly
                ? "Formato não suportado: vault aberto em somente leitura."
                : "Pasta conectada. Suas alterações serão salvas automaticamente; o botão Salvar continua disponível.";
        }
        catch (Exception exception)
        {
            _error = "Falha ao acessar o vault: " + exception.Message;
        }
        finally
        {
            _busy = false;
            if (_changedWhileBusy && Workspace.HasUnsavedChanges)
                ScheduleAutoSave();
            _changedWhileBusy = false;
        }
    }

    private Task Save()
    {
        CancelAutoSave();
        return SaveCoreAsync(automatic: false);
    }

    private async Task SaveCoreAsync(bool automatic)
    {
        if (_busy || !Host.IsConnected || Workspace.IsReadOnly)
            return;

        _busy = true;
        _confirmSwitch = false;
        _error = null;
        _message = automatic ? "Salvando alterações..." : null;
        try
        {
            await Host.SaveAsync(Workspace);
            _message = Workspace.HasUnsavedChanges
                ? "Uma gravação terminou, mas há novas edições pendentes."
                : automatic
                    ? "Alterações salvas automaticamente e verificadas no dispositivo."
                    : "Gravação concluída e verificada na pasta selecionada.";
        }
        catch (Exception exception)
        {
            _error = (automatic
                ? "Salvamento automático não confirmado: "
                : "Não foi possível confirmar o salvamento: ") +
                exception.Message;
        }
        finally
        {
            _busy = false;
            if (_changedWhileBusy && Workspace.HasUnsavedChanges &&
                _error is null)
                ScheduleAutoSave();
            _changedWhileBusy = false;
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Workspace.PersistenceChanged -= OnPersistenceChanged;
        CancelAutoSave();
    }
}
