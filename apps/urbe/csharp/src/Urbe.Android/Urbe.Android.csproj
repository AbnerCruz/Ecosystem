<Project Sdk="Microsoft.NET.Sdk">
  <!--
    DEC-0043 / ADR-0032 — head Android do cliente nativo (UC-33, prévia do gate G-N0).
    Identidade própria de prévia: instala ao lado da 1.8.4-beta e do beta MAUI, sem substituí-los.
    Não é canal de distribuição; identidade/canal definitivos são decididos no UC-25.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Urbe.AndroidHost</RootNamespace>
    <ApplicationTitle>Urbe nativo (prévia)</ApplicationTitle>
    <ApplicationId>app.urbe.nativepreview</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- só arm64: o motor da IA no aparelho pesa ~60 MB por arquitetura, e x86_64 é emulador -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <!--
      DEC-0048 / ADD-0025 — canal beta do Urbe C# no Android ("Urbe Beta 2.0"): única fonte da versão publicada.
      urbe-csharp-mobile-release.yml compila com -p:UrbeChannel=beta; sem isso o APK é a prévia acima.
    -->
    <!-- Corte autorizado da beta.25: builds nativos passam pelo workflow oficial
         urbe-csharp-mobile-release.yml; inclui agent runtime #726, UX #732
         e pesquisa pública #733 já integrados na main. Não publicar APK manual. -->
    <!-- Beta.26 includes the restored Assistant activity timeline (#738).
         After owner-authorized integration, the trusted integrator explicitly
         dispatches urbe-csharp-mobile-release: GITHUB_TOKEN push cannot trigger
         a second on:push workflow. Do not change the signed beta certificate. -->
    <UrbeBetaVersion>2.0.0-beta.38</UrbeBetaVersion>
    <UrbeBetaVersionCode>2000038</UrbeBetaVersionCode>
    <!-- Corte oficial da beta.27: UC-88 Grafos (PR #748), assistente contextual/FAB (#747)
         e pesquisa publica sem chave (#750) integrados na main.
         A identidade app.urbe.csharp e o certificado beta estavel permanecem.
         Somente integrador confiavel pode iniciar urbe-csharp-mobile-release.yml;
         nunca reutilizar artefatos ou tags da beta.26. -->
  </PropertyGroup>
  <!--
    UC-48 (desempenho no celular, "tá muito lagado"): o Release é todo compilado antes (AOT), não só a partida —
    o JIT compilando a cidade, o editor e os painéis durante o uso dava travadas; e o coletor de lixo concorrente
    pausa menos o app. O APK fica maior.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UrbeChannel)' == 'beta'">
    <ApplicationTitle>Urbe</ApplicationTitle>
    <ApplicationId>app.urbe.csharp</ApplicationId>
    <ApplicationDisplayVersion>$(UrbeBetaVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>$(UrbeBetaVersionCode)</ApplicationVersion>
    <DefineConstants>$(DefineConstants);URBE_BETA</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <!-- a IA que responde sem internet: o motor (llama.cpp) para CPU de celular, só arm64-v8a (os celulares de hoje) -->
    <PackageReference Include="LLamaSharp.Backend.Cpu.Android" Version="0.30.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Urbe.Client/Urbe.Client.csproj" />
    <ProjectReference Include="../Urbe.LocalAi/Urbe.LocalAi.csproj" />
  </ItemGroup>
</Project>
