<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <ApplicationId>io.ecosystem.ai.preview</ApplicationId>
    <ApplicationTitle>Ecosystem AI</ApplicationTitle>
    <ApplicationDisplayVersion>$(ProductVersion)-preview</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(AndroidPreviewBuildNumber)' != ''">$(AndroidPreviewBuildNumber)</ApplicationVersion>
    <ApplicationVersion Condition="'$(AndroidPreviewBuildNumber)' == ''">1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <!-- Catalog serialization uses reflection. Mono AOT with the untrimmed
         build aborts before OnCreate (class-init.c: instance_size assertion).
         Keep this preview on Mono JIT; validate AOT separately before enabling. -->
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidLinkMode>None</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)../../tools/ecosystem-ai-preview.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>ecoaipreview</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>pass:android</AndroidSigningStorePass>
    <AndroidSigningKeyPass>pass:android</AndroidSigningKeyPass>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../EcosystemAi.Product/EcosystemAi.Product.csproj" />
  </ItemGroup>
</Project>
