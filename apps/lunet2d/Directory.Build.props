<Project>
  <PropertyGroup>
    <LunetVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</LunetVersion>
    <Version>$(LunetVersion)</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <!-- UI screenshot builds only (tools/ci-ui-screens.sh, -p:LunetUiDemo=true); never set for releases. -->
  <PropertyGroup Condition="'$(LunetUiDemo)' == 'true'">
    <DefineConstants>$(DefineConstants);LUNET_UI_DEMO</DefineConstants>
  </PropertyGroup>
</Project>
