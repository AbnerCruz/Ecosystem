<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ADR 0013 / LUNET-531: Android head of the one Lunet shell (Lunet.Client, Avalonia). Installs NEXT TO the current
    app (io.lunet.studio, Android Views) until it covers the main flow; same stable development key (ADR 0004).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier Condition="'$(LunetEmulatorBuild)' != 'true'">android-arm64</RuntimeIdentifier>
    <!-- CI emulator only (x86_64, with the e2e hook of MainActivity); never released. -->
    <RuntimeIdentifier Condition="'$(LunetEmulatorBuild)' == 'true'">android-x64</RuntimeIdentifier>
    <DefineConstants Condition="'$(LunetEmulatorBuild)' == 'true'">$(DefineConstants);LUNET_EMULATOR</DefineConstants>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <RootNamespace>Lunet.ShellAndroid</RootNamespace>
    <ApplicationId>io.lunet.studio.shell</ApplicationId>
    <ApplicationTitle>Lunet Nova</ApplicationTitle>
    <ApplicationDisplayVersion>$(LunetVersion)</ApplicationDisplayVersion>
    <ApplicationVersion Condition="'$(GITHUB_RUN_NUMBER)' != ''">$(GITHUB_RUN_NUMBER)</ApplicationVersion>
    <ApplicationVersion Condition="'$(GITHUB_RUN_NUMBER)' == ''">1</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Roslyn compiles and loads games at runtime by reflection: no trimming, no AOT (same as the current app). -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(MSBuildThisFileDirectory)..\..\tools\lunet-dev.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>lunetdev</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>pass:android</AndroidSigningStorePass>
    <AndroidSigningKeyPass>pass:android</AndroidSigningKeyPass>
    <!-- Nullability annotations of the Android bindings must not break the build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Lunet.Client/Lunet.Client.csproj" />
  </ItemGroup>
</Project>
