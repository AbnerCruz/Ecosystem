<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.VIBRATE" />
  <!-- Normal permission; a standalone game may use the optional networking API. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Local APK packager preserves prebuilt native libraries in their original aligned ZIP entries;
       newly inserted game assets are compressed/stored independently. -->
  <application android:extractNativeLibs="true" />
</manifest>
