{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecosystem/contracts/enforcement-matrix/1",
  "title": "Matriz de enforcement das invariantes NN-XXX — schemaVersion 1",
  "description": "Autoridade canônica da associação NN-XXX → mecanismos de fiscalização (MANIFEST §0.2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "invariants"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "source": { "const": "MANIFEST.md#01-non-negotiables" },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "mechanisms"],
        "properties": {
          "id": { "type": "string", "pattern": "^NN-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 1 },
          "mechanisms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mechanism", "status", "how"],
              "properties": {
                "mechanism": { "enum": ["DOC", "SCHEMA", "TEST", "ARCH", "CI", "REVIEW", "ADR", "DEVICE", "RUNTIME"] },
                "status": {
                  "description": "implemented: fiscalizado hoje. manual: depende de revisão humana/de agente (sem automação). planned: ainda não existe; 'phase' indica quando.",
                  "enum": ["implemented", "manual", "planned"]
                },
                "how": { "type": "string", "minLength": 1 },
                "check": {
                  "description": "ID do check automatizado em tests/consistency/Check.cs que implementa o mecanismo. Obrigatório quando status = implemented e mechanism ∈ {SCHEMA, TEST, ARCH, CI} (verificado pelo check).",
                  "type": "string", "pattern": "^CHK-[A-Z0-9-]+$"
                },
                "phase": { "type": "string", "pattern": "^phase-[0-9]+$" }
              }
            }
          }
        }
      }
    }
  }
}
