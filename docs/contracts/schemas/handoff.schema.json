{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ecosystem/contracts/handoff/1",
  "title": "Handoff de agente — schemaVersion 1",
  "description": "Autoridade canônica do formato de handoff (MANIFEST §23.1, NN-008). Um arquivo por mensagem em docs/governance/handoffs/<message_id>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "message_id",
    "category",
    "timestamp",
    "agent",
    "task_id",
    "component",
    "state",
    "branch",
    "commit",
    "pr",
    "files_changed",
    "work_completed",
    "verification",
    "known_issues",
    "blockers",
    "next_actions",
    "decisions_required",
    "normative_sources",
    "invariants"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "message_id": {
      "type": "string",
      "pattern": "^HO-[0-9]{8}-[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "category": {
      "enum": [
        "HANDOFF",
        "RESULT",
        "BLOCKER",
        "INCIDENT"
      ]
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ai-agent",
            "human"
          ]
        },
        "session": {
          "type": "string"
        }
      }
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]+(\\.[0-9]+)*$"
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "state": {
      "enum": [
        "planned",
        "claimed",
        "working",
        "waiting",
        "blocked",
        "verifying",
        "review",
        "done",
        "failed",
        "cancelled"
      ]
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "description": "SHA do commit, ou null quando o handoff é gravado no próprio commit que descreve (o SHA é o do commit que introduz este arquivo).",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "pr": {
      "type": [
        "string",
        "null"
      ]
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "work_completed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "kind",
          "result"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "automated",
              "human"
            ]
          },
          "result": {
            "enum": [
              "passed",
              "failed",
              "pending",
              "not-applicable"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "object": {
            "description": "O que deve ser validado/decidido: caminho no repositório ou URL do artefato/página. Obrigatório (verificado por CHK-HANDOFFS) quando kind = human e result = pending, para que o portal apresente o objeto (DEC-0007).",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decisions_required": {
      "description": "IDs de decisões pendentes em docs/governance/decisions.json.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DEC-[0-9]{4}$"
      }
    },
    "normative_sources": {
      "description": "Documentos normativos consultados diretamente (NN-010).",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants": {
      "description": "Invariantes NN-XXX consideradas e evidência de respeito (MANIFEST §25).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^NN-[0-9]{3}$"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cost": {
      "type": [
        "string",
        "null"
      ]
    },
    "reuse_assessment": {
      "description": "OPCIONAL (ADR-0011): potencial de reutilização de uma feature ou refatoração estrutural relevante, registrado onde o trabalho foi feito. Ausente em handoffs que não criam nem reestruturam funcionalidade. Quando presente, o check CHK-REUSE valida a semântica.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject",
          "status",
          "rationale"
        ],
        "properties": {
          "subject": {
            "description": "Slug estável da capacidade avaliada (por exemplo 'account-login'). O mesmo slug em handoffs de componentes diferentes significa a mesma necessidade.",
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "status": {
            "enum": [
              "product-specific",
              "possible-candidate",
              "external-consumer-exists"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "consumers": {
            "description": "Componentes (ids de ecosystem.json) que usam ou precisam concretamente da capacidade além do dono. Obrigatório (>= 1) em external-consumer-exists.",
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
            }
          },
          "extraction_review": {
            "description": "Só em external-consumer-exists: 'pending' (a Extraction Review ainda não terminou), um ADR do Ecosystem (ADR-NNNN) que a concluiu, ou 'declined' (a review concluiu que continua local; a justificativa vai em rationale).",
            "type": "string",
            "pattern": "^(pending|declined|ADR-[0-9]{4})$"
          }
        }
      }
    }
  }
}
